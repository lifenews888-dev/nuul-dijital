generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("NEWS_DATABASE_URL")
  directUrl = env("NEWS_DIRECT_URL")
}

// ===================== PARLIAMENT NEWS =====================
// Тусдаа өгөгдлийн сан: Gerel News-ийн контент nuul.mn-ийн захиалга,
// төлбөрийн өгөгдлөөс бүрэн салсан. Хүснэгт бүр pn_ префикстэй.
// Эх сурвалж: apps/parliament-news/site-v2 (Claude artifact загвар)

/// Редакцын хэрэглэгч. nuul.mn-ийн users хүснэгтээс тусдаа — эрх нь
/// TenantMember дээр, платформын UserRole энд байхгүй.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  newsMemberships TenantMember[]
  newsPosts       NewsPost[]
  newsComments    NewsComment[]

  @@map("pn_users")
}
// Multi-tenant мэдээний платформ. Бүх хүснэгт pn_ префикстэй.
// Эх сурвалж: apps/parliament-news/site-v2 (Claude artifact загвар)

model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  domains     String[]
  logoUrl     String?
  brandColor  String   @default("#1d3fe3")
  accentColor String   @default("#f26a1b")
  locale      String   @default("mn")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       TenantMember[]
  posts         NewsPost[]
  media         NewsMedia[]
  categories    NewsCategory[]
  slugRedirects NewsSlugRedirect[]
  comments      NewsComment[]
  activity      NewsActivity[]
  settings      TenantSetting[]
  bills         Bill[]
  agenda        Agenda[]
  live          LiveState?
  banners       Banner[]
  tickerAds     TickerAd[]
  adRates       AdRate[]
  fxRates       FxRate[]

  @@map("pn_tenants")
}

model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      NewsRole
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("pn_tenant_members")
}

/// Редакцын 10 эрх — site-v2/admin.html:844-854
enum NewsRole {
  SUPER
  CHIEF
  REVIEWER
  REPORTER
  MEDIA
  LEGAL
  SOCIAL
  LIVE
  CONTRIBUTOR
  ANALYST
}

/// Редакцын урсгал — site-v2/admin.html
enum NewsStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  RETURNED
}

model NewsPost {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug        String
  title       String       @db.VarChar(200)
  kicker      String?      @db.VarChar(60)
  lead        String?      @db.VarChar(400)
  body        String?      @db.Text
  date        DateTime     @db.Date
  categoryId  String?
  category    NewsCategory? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: SetNull)
  subcategory String?      @db.VarChar(40)
  reporter    String?      @db.VarChar(60)
  sources     String[]
  motif       String       @default("grid")
  look        Json?
  theme       Int          @default(0)
  featured    Boolean      @default(false)
  story       Boolean      @default(false)
  storyUntil  DateTime?
  tags        String[]
  channels    String[]
  status      NewsStatus   @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  authorId    String?
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reviewNote  String?      @db.Text
  views       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  media         NewsMedia[]
  comments      NewsComment[]
  slugRedirects NewsSlugRedirect[]
  bill          Bill?

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, categoryId])
  @@map("pn_posts")
}

model NewsMedia {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  postId   String
  post     NewsPost @relation(fields: [tenantId, postId], references: [tenantId, id], onDelete: Cascade)
  kind     String   @default("image")
  url      String
  caption  String?  @db.VarChar(200)
  order    Int      @default(0)

  @@index([postId])
  @@map("pn_media")
}

model NewsCategory {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug     String
  name     String  @db.VarChar(40)
  parentId String?
  parent   NewsCategory?  @relation("NewsCategoryTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: SetNull)
  children NewsCategory[] @relation("NewsCategoryTree")
  inMenu   Boolean @default(false)
  order    Int     @default(0)

  posts NewsPost[]

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId, parentId])
  @@map("pn_categories")
}

model NewsSlugRedirect {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromSlug  String
  postId    String
  post      NewsPost @relation(fields: [tenantId, postId], references: [tenantId, id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, fromSlug])
  @@map("pn_slug_redirects")
}

model NewsComment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  postId     String
  post       NewsPost @relation(fields: [tenantId, postId], references: [tenantId, id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String   @db.VarChar(60)
  body       String   @db.VarChar(600)
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([tenantId, postId])
  @@map("pn_comments")
}

model NewsActivity {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  postId    String?
  userId    String?
  action    String
  note      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("pn_activity")
}

model TenantSetting {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@map("pn_settings")
}

model Bill {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  postId    String?  @unique
  post      NewsPost? @relation(fields: [tenantId, postId], references: [tenantId, id], onDelete: SetNull)
  title     String   @db.VarChar(200)
  stage     Int      @default(0)
  votesYes  Int      @default(0)
  votesNo   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages BillStage[]

  @@unique([tenantId, id])
  @@unique([tenantId, postId])
  @@index([tenantId, stage])
  @@map("pn_bills")
}

model BillStage {
  id       String    @id @default(cuid())
  tenantId String
  billId   String
  bill     Bill      @relation(fields: [tenantId, billId], references: [tenantId, id], onDelete: Cascade)
  index    Int
  date     DateTime? @db.Date
  note     String?   @db.VarChar(1500)
  sources  String[]

  @@unique([billId, index])
  @@index([tenantId])
  @@map("pn_bill_stages")
}

model Agenda {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  time     String   @db.VarChar(8)
  text     String   @db.VarChar(120)
  order    Int      @default(0)

  @@index([tenantId, date])
  @@map("pn_agenda")
}

model LiveState {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendance     Int      @default(0)
  sessionStatus  String   @default("Хуралдаж байна")
  tickerOn       Boolean  @default(true)
  liveOn         Boolean  @default(false)
  liveTitle      String?  @db.VarChar(80)
  liveUrl        String?
  breakingOn     Boolean  @default(false)
  breakingText   String?  @db.VarChar(140)
  breakingPostId String?
  updatedAt      DateTime @updatedAt
  updatedById    String?

  @@map("pn_live")
}

model Banner {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imageUrl  String
  linkUrl   String?
  title     String?   @db.VarChar(80)
  placement String    @default("both")
  startsOn  DateTime? @db.Date
  endsOn    DateTime? @db.Date
  paid      Boolean   @default(true)
  amount    Int       @default(0)
  order     Int       @default(0)

  @@index([tenantId, placement])
  @@map("pn_banners")
}

model TickerAd {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  text     String  @db.VarChar(120)
  url      String?
  active   Boolean @default(true)
  order    Int     @default(0)

  @@index([tenantId])
  @@map("pn_ticker_ads")
}

model AdRate {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  place    String  @db.VarChar(60)
  size     String? @db.VarChar(40)
  unit     String  @default("week")
  price    Int     @default(0)
  note     String? @db.VarChar(120)
  order    Int     @default(0)

  @@index([tenantId])
  @@map("pn_ad_rates")
}

model FxRate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String   @db.VarChar(8)
  value     Decimal  @db.Decimal(14, 4)
  change    Decimal  @default(0) @db.Decimal(10, 4)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@map("pn_fx_rates")
}
