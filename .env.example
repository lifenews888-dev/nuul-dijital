# Database (Supabase/Railway-аас авна)
DATABASE_URL="postgresql://user:password@localhost:5432/nuul_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="openssl rand -base64 32"

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# QPay (merchant.qpay.mn)
QPAY_ENV="sandbox"
QPAY_CLIENT_ID=""
QPAY_CLIENT_SECRET=""
QPAY_INVOICE_CODE=""

# SocialPay
SOCIALPAY_MERCHANT_ID=""
SOCIALPAY_TERMINAL_ID=""
SOCIALPAY_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob (storage - zurag upload)
# Vercel Dashboard > Storage > Create > Blob -aas avna
BLOB_READ_WRITE_TOKEN=""

# --- Parliament News (apps/parliament-news) ---
# Мэдээний сан нь nuul.mn-ийнхээс ТУСДАА. Хөгжүүлэлтэд:
#   cd packages/db-news && docker compose up -d
NEWS_DATABASE_URL="postgresql://parlament:parlament_local_dev@127.0.0.1:5447/parlamentnews"
NEWS_DIRECT_URL="postgresql://parlament:parlament_local_dev@127.0.0.1:5447/parlamentnews"
# Аль tenant-ыг үйлчлэх (тохируулаагүй бол "parlament")
NEWS_TENANT_SLUG="parlament"
# Бүтэн хаягууд: canonical, Open Graph, sitemap, RSS үүнээс бүтнэ
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
