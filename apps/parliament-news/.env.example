# Parliament News — Vercel дээр тавих орчны хувьсагчид
#
# ЭНЭ ФАЙЛД УТГА БИЧИХГҮЙ. Нэр, тайлбар л энд байна; жинхэнэ утгыг
# Vercel-ийн dashboard дээр (Project → Settings → Environment Variables)
# ӨӨРӨӨ оруулна. Нууц утга repo-д, чат-д, лог-д орохгүй.
#
# Дутуу хувьсагчтай бол апп 500 буцаана. Deploy-ийн ДАРАА шууд шалга:
#   curl -s -o /dev/null -w '%{http_code}\n' https://parlamentnews.mn/

# ─── Өгөгдлийн сан (nuul.mn-ийнхээс ӨӨР project) ───────────────────────
# Supabase → Project Settings → Database → Connection string
# Pooled (6543, pgbouncer) — апп үүнийг хэрэглэнэ
NEWS_DATABASE_URL=
# Direct (5432) — зөвхөн `prisma db push`-д
NEWS_DIRECT_URL=

# ─── Нэвтрэлт ──────────────────────────────────────────────────────────
# ЗААВАЛ. nuul.mn-ийн NEXTAUTH_SECRET-ээс ӨӨР байх ёстой; ижил байвал апп
# асахаасаа өмнө чангаар унана (`lib/auth-env.ts`).
#   openssl rand -base64 32
NEWS_NEXTAUTH_SECRET=
# https://parlamentnews.mn
NEXTAUTH_URL=

# ─── Нийтийн хаяг ──────────────────────────────────────────────────────
# canonical, Open Graph, sitemap, RSS бүгд эндээс бүтнэ. Буруу бол
# хуваалцсан холбоос localhost руу чиглэнэ.
NEXT_PUBLIC_SITE_URL=https://parlamentnews.mn

# ─── Файл байршуулалт ──────────────────────────────────────────────────
# Vercel → Storage → Blob. Зураг, видео, лого, баннер бүгд эндээс.
BLOB_READ_WRITE_TOKEN=

# ─── Сонголттой ────────────────────────────────────────────────────────
# Анхдагч нь `parlament`. Seed-ийн үүсгэсэн Tenant.slug-тай таарах ёстой.
NEWS_TENANT_SLUG=

# ─── Сошиал автомат нийтлэл (сонголттой) ───────────────────────────────
# Эдгээр тавигдаагүй бол дараалал нь мөрөө SKIPPED болгоно — алдаа БИШ.
#
# Telegram: @BotFather-аас бот үүсгээд токен авна; ботоо сувагтаа админ
# болгоод суваг нэрийг (@parlamentnews) эсвэл chat id-г тавина.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# `/api/social/dispatch`-ийг хамгаална. Тавигдаагүй бол тэр зам 404.
#   openssl rand -hex 24
SOCIAL_DISPATCH_SECRET=
